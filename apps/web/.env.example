# Copy to .env.local. Never commit a real .env.local.
# Leave an optional line commented out to use its default; an empty value also
# means "use the default".

# --- Required for Google sign-in -------------------------------------------
# From Supabase: Project Settings > API. The anon key is meant to be public.
# Without these, /signin shows "Sign-in is not set up on this server yet."
# In the Supabase dashboard also set:
#   Authentication > Sign In / Providers > Google: enabled, with your Google
#     OAuth client ID and secret. In Google Cloud the client's authorised
#     redirect URI is https://<project-ref>.supabase.co/auth/v1/callback
#   Authentication > URL Configuration: Site URL http://localhost:3000 and
#     Redirect URL http://localhost:3000/** (add your deployed origin too).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required for fee sponsorship (server only) -----------------------------
# A testnet account the relay uses as transaction source. It signs only the
# transaction envelope (never user auth) and holds only friendbot XLM. Create
# one with Keypair.random(), fund it at https://friendbot.stellar.org/?addr=G...
# Without it, /api/relay refuses everything.
# RELAY_SOURCE_SECRET=
# OpenZeppelin Channels key for sponsored calls to existing contracts (USDC
# transfers, split deposits). Free testnet key: https://channels.openzeppelin.com/testnet/gen
# Without it, those calls are refused; wallet creation still works.
# CHANNELS_API_KEY=

# --- Optional ----------------------------------------------------------------
# OpenZeppelin Channels base URL. Default: https://channels.openzeppelin.com/testnet
# CHANNELS_BASE_URL=https://channels.openzeppelin.com/testnet


# Stellar RPC. Default: https://soroban-testnet.stellar.org
# Must be https, except a local RPC on localhost / 127.0.0.1 / [::1].
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Fee relayer that /api/relay forwards to (server only).
# Default: SDF's public testnet smart-account relayer proxy.
# RELAYER_UPSTREAM=https://smart-account-relayer-proxy.sdf-ecosystem.workers.dev
